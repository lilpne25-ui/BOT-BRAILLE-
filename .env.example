# Database
# Local demo / Vercel production should use a PostgreSQL URL reachable by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bidesign_crm_demo_v105?schema=public&sslmode=require"

# Authentication
AUTH_SECRET="<GENERATE_LOCALLY_MIN_32_CHARS>"
AUTH_SECURE_COOKIE="0"

# BI DESIGN Web integration
WEB_LEADS_ENABLED="0"
WEB_LEADS_WEBHOOK_KEY="<GENERATE_LOCALLY>"

# WhatsApp
WHATSAPP_PROVIDER="mock"
WHATSAPP_VERIFY_TOKEN="<SECRET>"
WHATSAPP_ACCESS_TOKEN="<SECRET>"
WHATSAPP_PHONE_NUMBER_ID="<ID>"
WHATSAPP_BUSINESS_ACCOUNT_ID="<ID>"
META_APP_SECRET="<SECRET>"
WHATSAPP_BAILEYS_AUTH_DIR=".wa-auth"

# OpenAI / speech
OPENAI_API_KEY="<SECRET>"
OPENAI_STT_MODEL="whisper-1"
OPENAI_STT_LANGUAGE="es"
