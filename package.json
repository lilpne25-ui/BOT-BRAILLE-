{
    "name":  "bi-design-crm",
    "version":  "1.0.0",
    "private":  true,
    "description":  "CRM comercial y operativo de BI DESIGN - Senalizacion y Remodelacion Retail.",
    "engines":  {
                    "node":  ">=22.11.0",
                    "npm":  ">=10.9.0"
                },
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "prisma generate && next build",
                    "start":  "next start",
                    "lint":  "next lint",
                    "test":  "vitest run",
                    "verify:env":  "node scripts/verify-env.mjs",
                    "audit:summary":  "node scripts/audit-summary.mjs",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "prisma:seed":  "prisma db seed",
                    "prisma:init-sqlite":  "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
                    "prisma:reset-sqlite":  "prisma db push --force-reset",
                    "db:setup":  "npm run prisma:generate && npm run prisma:reset-sqlite && npm run prisma:seed"
                },
    "dependencies":  {
                         "@hookform/resolvers":  "^3.10.0",
                         "@prisma/client":  "^6.16.0",
                         "@radix-ui/react-dialog":  "^1.1.4",
                         "@radix-ui/react-dropdown-menu":  "^2.1.4",
                         "@radix-ui/react-label":  "^2.1.1",
                         "@radix-ui/react-select":  "^2.1.4",
                         "@radix-ui/react-separator":  "^1.1.1",
                         "@radix-ui/react-slot":  "^1.1.1",
                         "@radix-ui/react-tabs":  "^1.1.2",
                         "@whiskeysockets/baileys":  "^7.0.0-rc13",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "framer-motion":  "^11.18.2",
                         "jspdf":  "^2.5.2",
                         "lucide-react":  "^0.468.0",
                         "next":  "14.2.35",
                         "pino":  "^10.3.1",
                         "prisma":  "^6.16.0",
                         "qrcode":  "^1.5.4",
                         "react":  "18.3.1",
                         "react-dom":  "18.3.1",
                         "react-hook-form":  "^7.54.2",
                         "recharts":  "^2.15.0",
                         "tailwind-merge":  "^2.6.0",
                         "tailwindcss-animate":  "^1.0.7",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.17.10",
                            "@types/qrcode":  "^1.5.6",
                            "@types/react":  "^18.3.17",
                            "@types/react-dom":  "^18.3.5",
                            "autoprefixer":  "^10.4.20",
                            "eslint":  "^8.57.1",
                            "eslint-config-next":  "14.2.35",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.7.2",
                            "vitest":  "^2.1.8"
                        },
    "prisma":  {
                   "seed":  "node prisma/seed.mjs"
               },
    "allowScripts":  {
                         "prisma":  true,
                         "@prisma/client":  true,
                         "@prisma/engines":  true,
                         "esbuild":  true,
                         "sharp":  true,
                         "protobufjs":  true,
                         "@whiskeysockets/baileys":  true
                     }
}
